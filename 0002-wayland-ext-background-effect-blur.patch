+
+void nsWindowWayland::ClearBackgroundBlur() {
+  MozClearPointer(mBackgroundEffect, ext_background_effect_surface_v1_destroy);
+  mBackgroundEffectSurface = nullptr;
+  mBackgroundBlurRegion.SetEmpty();
+}
+
+static void SubtractRoundedCorner(LayoutDeviceIntRegion& aRegion,
+                                  const LayoutDeviceIntRect& aRect, int aRadius,
+                                  bool aRight) {
+  for (int y = 0; y < aRadius; y++) {
+    double dy = aRadius - y - 0.5;
+    int cut = aRadius - int(floor(sqrt(double(aRadius * aRadius) - dy * dy)));
+    if (cut <= 0) {
+      continue;
+    }
+    int x = aRight ? aRect.XMost() - cut : aRect.x;
+    aRegion.SubOut(LayoutDeviceIntRect(x, aRect.y + y, cut, 1));
+  }
+}
+
+static bool BackgroundBlurRegionIsGeometryRelative() {
+  switch (StaticPrefs::widget_wayland_background_blur_region_origin()) {
+    case 1:
+      return false;
+    case 2:
+      return true;
+    default: {
+      static bool sIsCosmic = !!FindInReadable(
+          "cosmic"_ns, widget::GetDesktopEnvironmentIdentifier());
+      return sIsCosmic;
+    }
+  }
+}
+
+void nsWindowWayland::UpdateBackgroundBlur() {
+  GdkWindow* toplevel = GetToplevelGdkWindow();
+  wl_surface* surface = toplevel && mIsMapped
+                            ? gdk_wayland_window_get_wl_surface(toplevel)
+                            : nullptr;
+  if (surface != mBackgroundEffectSurface) {
+    ClearBackgroundBlur();
+  }
+
+  auto* manager = WaylandDisplayGet()->GetBackgroundBlurManager();
+  bool enabled =
+      manager && surface && mCompositedScreen &&
+      StaticPrefs::widget_wayland_background_blur_enabled() &&
+      (mWindowType == WindowType::TopLevel ||
+       (IsPopup() && StaticPrefs::widget_wayland_background_blur_popups()));
+
+  LayoutDeviceIntRegion blurRegion;
+  if (enabled) {
+    const auto clientRect =
+        LayoutDeviceIntRect(LayoutDeviceIntPoint(), GetClientSize());
+    // Blur the whole client area, not only its translucent parts. Blur
+    // behind opaque content is invisible, but following the opaque region
+    // changes the blur region on every page load, bookmarks bar or find bar
+    // change, and those updates reach the compositor in a toplevel commit
+    // that is not synced with the content frame, which shows as flicker.
+    blurRegion = clientRect;
+    if (DoDrawTilebarCorners()) {
+      int radius =
+          int(ceil(LookAndFeel::GetInt(LookAndFeel::IntID::TitlebarRadius) *
+                   FractionalScaleFactor()));
+      SubtractRoundedCorner(blurRegion, clientRect, radius, false);
+      SubtractRoundedCorner(blurRegion, clientRect, radius, true);
+    }
+  }
+
+  if (blurRegion.IsEmpty()) {
+    if (mBackgroundEffect && !mBackgroundBlurRegion.IsEmpty()) {
+      LOG("nsWindowWayland::UpdateBackgroundBlur() remove blur");
+      ext_background_effect_surface_v1_set_blur_region(mBackgroundEffect,
+                                                       nullptr);
+      mBackgroundBlurRegion.SetEmpty();
+      ForceToplevelCommit();
+    }
+    return;
+  }
+
+  if (!mBackgroundEffect) {
+    mBackgroundEffect = ext_background_effect_manager_v1_get_background_effect(
+        manager, surface);
+    mBackgroundEffectSurface = surface;
+  }
+
+  // The region is in toplevel surface coordinates, but our client area is
+  // offset by mGdkWindow position (CSD shadows). Compositors that place the
+  // region relative to the window geometry already include that offset.
+  GdkPoint offset{0, 0};
+  if (!BackgroundBlurRegionIsGeometryRelative()) {
+    gdk_window_get_position(mGdkWindow, &offset.x, &offset.y);
+  }
+
+  LayoutDeviceIntRegion surfaceRegion;
+  for (auto iter = blurRegion.RectIter(); !iter.Done(); iter.Next()) {
+    auto rect = DevicePixelsToGdkRectRoundOut(iter.Get());
+    surfaceRegion.OrWith(LayoutDeviceIntRect(rect.x + offset.x,
+                                             rect.y + offset.y, rect.width,
+                                             rect.height));
+  }
+  if (surfaceRegion == mBackgroundBlurRegion) {
+    return;
+  }
+  mBackgroundBlurRegion = surfaceRegion;
+
+  wl_region* region =
+      wl_compositor_create_region(WaylandDisplayGet()->GetCompositor());
+  for (auto iter = surfaceRegion.RectIter(); !iter.Done(); iter.Next()) {
+    const auto& rect = iter.Get();
+    wl_region_add(region, rect.x, rect.y, rect.width, rect.height);
+  }
+  LOG("nsWindowWayland::UpdateBackgroundBlur() set blur region");
+  ext_background_effect_surface_v1_set_blur_region(mBackgroundEffect, region);
+  wl_region_destroy(region);
+  ForceToplevelCommit();
+}
 
